# Apache example for OpenCart 2.3. Keep the production .htaccess untracked.
Options -Indexes

<FilesMatch "(?i)^(config\.php|LocalValetDriver\.php|test\.php|gath\.php|webstanje\.csv)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(ini|log|sql|tpl|twig|yaml|yml)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

# One canonical production origin. Keep these rules before the front controller.
RewriteCond %{HTTP_HOST} !^www\.watchline\.hr$ [NC]
RewriteRule ^ https://www.watchline.hr%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.watchline.hr%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^(?:system|vqmod)/ - [F,L,NC]
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L,NE]
RewriteRule ^googlebase\.xml$ index.php?route=extension/feed/google_base [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^?]*) index.php?_route_=$1 [L,QSA]
