	<file path="catalog/controller/" name="common/seo_url.php,startup/seo_url.php">
	    <operation>
            <search position="before" offset="1"><![CDATA[$this->request->get['route'] = 'error/not_found';]]></search>
            <add><![CDATA[
			} elseif ($part == 'sitemap-index.xml') {
				if (version_compare(VERSION, '2.2.0.0', '<')) {
					$this->request->get['route'] = 'feed/boost_sitemap';
				} else {
					$this->request->get['route'] = 'extension/feed/boost_sitemap';
				}

				break;
            ]]></add>
        </operation>
    </file>
	
</modification>